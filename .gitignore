# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — Next.js loads plain .env too, so ignore every variant
# and re-allow only the committed placeholder examples.
.env
.env.*
!.env.example
!.env.local.example

# vercel
.vercel

# claude code personal settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Quell-Design-System (lokal, nicht versioniert)
# Enthält interne Business-OS-Entwürfe, Porträtfotos und die Spec/Design der
# alexmacht-Website — gehört nicht in ein Repo, das für die Abgabe public wird.
# Alle für dieses Projekt nötigen Werte sind nach docs/design-system.md übernommen.
docs/alexmacht.at Design System */

# Playwright (Lauf-Artefakte, keine Quellen)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
